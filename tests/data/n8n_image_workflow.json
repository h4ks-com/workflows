{
 "id": "wfImageExec0001",
 "name": "Workflows Executor: Image",
 "active": true,
 "tags": [
  {
   "name": "h4ks-workflows"
  }
 ],
 "nodes": [
  {
   "name": "Job In",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2.1,
   "parameters": {
    "path": "workflows-image",
    "httpMethod": "POST"
   }
  },
  {
   "name": "Job Form",
   "type": "n8n-nodes-base.formTrigger",
   "typeVersion": 2.6,
   "parameters": {
    "authentication": "n8nUserAuth",
    "formTitle": "Image",
    "formDescription": "Create an image from a description.",
    "formFields": {
     "values": [
      {
       "fieldLabel": "Prompt",
       "fieldType": "textarea",
       "fieldName": "prompt",
       "placeholder": "What the image should show.",
       "requiredField": true
      },
      {
       "fieldLabel": "Model",
       "fieldType": "dropdown",
       "fieldName": "model",
       "defaultValue": "z-image",
       "fieldOptions": {
        "values": [
         {
          "option": "z-image"
         },
         {
          "option": "flux-klein"
         }
        ]
       }
      },
      {
       "fieldType": "html",
       "html": "<p>z-image looks best from a prompt; flux-klein is faster and takes a reference.</p>"
      },
      {
       "fieldLabel": "Reference image",
       "fieldType": "file",
       "fieldName": "reference_url",
       "multipleFiles": false,
       "acceptFileTypes": "image/*"
      },
      {
       "fieldType": "html",
       "html": "<p>An image to edit or take the look from. Link, upload or drop one.</p>"
      },
      {
       "fieldLabel": "Shape",
       "fieldType": "dropdown",
       "fieldName": "shape",
       "defaultValue": "square",
       "fieldOptions": {
        "values": [
         {
          "option": "square"
         },
         {
          "option": "portrait"
         },
         {
          "option": "landscape"
         }
        ]
       }
      },
      {
       "fieldType": "html",
       "html": "<p>Shape of the image.</p>"
      },
      {
       "fieldLabel": "Size",
       "fieldType": "dropdown",
       "fieldName": "size",
       "defaultValue": "normal",
       "fieldOptions": {
        "values": [
         {
          "option": "normal"
         },
         {
          "option": "large"
         }
        ]
       }
      },
      {
       "fieldType": "html",
       "html": "<p>normal is about 1 megapixel; large is about 2.3 and costs double.</p>"
      }
     ]
    },
    "options": {
     "appendAttribution": false,
     "path": "workflows-image-form",
     "respondWithOptions": {
      "values": {
       "formSubmittedText": "Started. Open the execution in n8n to follow it; results land in the workflows bucket."
      }
     }
    }
   },
   "notes": "{\n  \"pricing\": \"40 credits per image, 80 for large\",\n  \"price\": \"80 if size == 'large' else 40\",\n  \"steps\": [[\"generate\", 85], [\"store\", 15]],\n  \"position\": 4,\n  \"fields\": {\n    \"reference_url\": {\"show_when\": {\"model\": \"flux-klein\"}}\n  }\n}",
   "notesInFlow": true
  }
 ],
 "connections": {
  "Job Form": {
   "main": [
    [
     {
      "node": "Form Files",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Job In": {
   "main": [
    [
     {
      "node": "Read Job",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}