{
 "id": "wfImageExec0001",
 "name": "Workflows Executor: Image",
 "active": true,
 "tags": [
  {
   "name": "h4ks-workflows"
  }
 ],
 "nodes": [
  {
   "name": "Job In",
   "type": "n8n-nodes-base.webhook",
   "typeVersion": 2.1,
   "parameters": {
    "path": "workflows-image",
    "httpMethod": "POST"
   }
  },
  {
   "name": "Job Form",
   "type": "n8n-nodes-base.formTrigger",
   "typeVersion": 2.6,
   "parameters": {
    "formTitle": "Image",
    "formDescription": "Create an image from a description.",
    "formFields": {
     "values": [
      {
       "fieldName": "prompt",
       "fieldLabel": "Prompt",
       "requiredField": true,
       "fieldType": "textarea",
       "placeholder": "What the image should show."
      },
      {
       "fieldName": "model",
       "fieldLabel": "Model",
       "requiredField": false,
       "fieldType": "dropdown",
       "fieldOptions": {
        "values": [
         {
          "option": "z-image"
         },
         {
          "option": "flux-klein"
         }
        ]
       },
       "defaultValue": "z-image"
      },
      {
       "fieldName": "reference_url",
       "fieldLabel": "Reference image",
       "requiredField": false,
       "fieldType": "file",
       "acceptFileTypes": "image/*",
       "multipleFiles": false
      },
      {
       "fieldName": "shape",
       "fieldLabel": "Shape",
       "requiredField": false,
       "fieldType": "dropdown",
       "fieldOptions": {
        "values": [
         {
          "option": "square"
         },
         {
          "option": "portrait"
         },
         {
          "option": "landscape"
         }
        ]
       },
       "defaultValue": "square"
      },
      {
       "fieldName": "size",
       "fieldLabel": "Size",
       "requiredField": false,
       "fieldType": "dropdown",
       "fieldOptions": {
        "values": [
         {
          "option": "normal"
         },
         {
          "option": "large"
         }
        ]
       },
       "defaultValue": "normal"
      }
     ]
    },
    "options": {
     "path": "workflows-image-form",
     "appendAttribution": false,
     "respondWithOptions": {
      "values": {
       "respondWith": "text",
       "formSubmittedText": "Started. Open the execution in n8n to follow it; results land in the workflows bucket."
      }
     }
    },
    "authentication": "n8nUserAuth",
    "responseMode": "onReceived"
   },
   "disabled": false
  },
  {
   "name": "h4ks workflows manifest",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "parameters": {
    "width": 520,
    "height": 560,
    "color": 4,
    "content": "## h4ks workflows\nThe disabled Job Form defines the form on workflows.h4ks.com; this note adds what n8n forms cannot hold. See n8n/README.md in h4ks-com/workflows.\n```h4ks-workflows\n{\n  \"pricing\": \"40 credits per image, 80 for large\",\n  \"price\": \"80 if size == 'large' else 40\",\n  \"steps\": [[\"generate\", 85], [\"store\", 15]],\n  \"position\": 4,\n  \"fields\": {\n    \"model\": {\"description\": \"z-image looks best from a prompt; flux-klein is faster and takes a reference.\"},\n    \"reference_url\": {\"description\": \"An image to edit or take the look from. Link, upload or drop one.\", \"show_when\": {\"model\": \"flux-klein\"}},\n    \"shape\": {\"description\": \"Shape of the image.\"},\n    \"size\": {\"description\": \"normal is about 1 megapixel; large is about 2.3 and costs double.\"}\n  }\n}\n```"
   }
  }
 ],
 "connections": {
  "Job Form": {
   "main": [
    [
     {
      "node": "Form Files",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Job In": {
   "main": [
    [
     {
      "node": "Read Job",
      "type": "main",
      "index": 0
     }
    ]
   ]
  }
 }
}